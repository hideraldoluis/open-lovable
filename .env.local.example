# Copy to .env.local and fill in. Restart `next dev` after changing it.

# --- Sandbox -----------------------------------------------------------------
# Runs the generated app on this machine: a folder in the temp dir + a Vite
# dev server. No isolation - generated code runs with your user's permissions.
SANDBOX_PROVIDER=local
# Optional
# LOCAL_SANDBOX_PORT=5173
# LOCAL_SANDBOX_DIR=C:\path\to\sandboxes

# --- Firecrawl (self-hosted) ---------------------------------------------------
# Run it with: git clone https://github.com/firecrawl/firecrawl && cd firecrawl && docker compose up -d --build
# Self-hosted auth is off by default, so the key can be any non-empty value.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=local

# --- LLM: any OpenAI-compatible server ------------------------------------------
# The model id is sent as-is unless it starts with anthropic/, google/ or openai/.
# Pick ONE of the two blocks below.

# Option A: OpenRouter (base URL must NOT include /chat/completions)
GROQ_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=your_openrouter_api_key
NEXT_PUBLIC_LOCAL_MODEL=deepseek/deepseek-v4.1-flash

# Option B: Ollama
# GROQ_BASE_URL=http://localhost:11434/v1
# GROQ_API_KEY=ollama
# NEXT_PUBLIC_LOCAL_MODEL=qwen3:8b
